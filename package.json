{
  "name": "dsh-notify-bell",
  "version": "0.11.2",
  "license": "MIT",
  "description": "DSH notification plugin with semantic sounds (done/block/permission/question/error): final assistant answer, approval/asked, ask_user_question, goal block, and agent/error notify via BEL or WAV. Official Cordis plugin form: Config schema, bundle patch (dsh.bundle), Web bell toggle in the session header. Configurable via cordis.yml or the legacy ~/.config/dsh/notify-bell.json (bellCount still accepted).",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config.js": "./src/config.js",
    "./events.js": "./src/events.js",
    "./turns.js": "./src/turns.js",
    "./bell.js": "./src/bell.js",
    "./wav.js": "./src/wav.js",
    "./audio.js": "./src/audio.js",
    "./sse.js": "./src/sse.js",
    "./browser-audio.js": "./src/browser-audio.js",
    "./log.js": "./src/log.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/config.js",
    "src/events.js",
    "src/turns.js",
    "src/bell.js",
    "src/wav.js",
    "src/audio.js",
    "src/sse.js",
    "src/browser-audio.js",
    "src/log.js",
    "src/client.js",
    "cordis.patch.yml",
    "sound-showcase",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6"
  },
  "scripts": {
    "test": "node --test src/test.js src/session-layer.test.js",
    "test:unit": "node --test src/test.js",
    "test:session": "node --test src/session-layer.test.js"
  }
}
